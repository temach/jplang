You logged in, now configure your tunnel on your local machine.
Edit your local ssh config, open ssh tunnel and then always pass keyservice option to sops:

# cat ~/.ssh/config
Host sops-tunnel-kms
  HostName moonspeak.org
  Port 2222
  User kms
  # tunnel from localhost port 5000 to remote unix socket
  LocalForward 127.0.0.1:5000 /home/kms/.ssh/sops.sock
  ExitOnForwardFailure yes
  SessionType none
  ServerAliveInterval 60
  IdentityFile ~/.ssh/id_rsa


# ssh sops-tunnel-kms
# sops --keyservice tcp://127.0.0.1:5000 mysecret.yaml
